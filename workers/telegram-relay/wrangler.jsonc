{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "urbanqueen-telegram-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-08-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ORIGIN_WEBHOOK_URL": "https://access.urban-queen.com/api/webhooks/telegram",
    "ALLOWED_CHAT_IDS": "-1003872347411"
  }
}
