[Unit]
Description=UrbanQueen Access API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=urbanqueen
Group=urbanqueen
WorkingDirectory=/opt/urbanqueen-access
EnvironmentFile=/etc/urbanqueen/access.env
ExecStart=/usr/bin/node /opt/urbanqueen-access/apps/api/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/urbanqueen

[Install]
WantedBy=multi-user.target
